---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
  <title>AgentHive Blog</title>
  <subtitle>Guides, deep dives, and comparisons on running multi-agent AI: orchestration, agent memory, automation, and the tooling landscape.</subtitle>
  <link href="/blog/feed.xml" rel="self" />
  <link href="/blog/" />
  <updated>{{ collections.posts[0].date | isoDate }}</updated>
  <id>/blog/</id>
  <author><name>Ayush Singh</name><uri>https://github.com/ayushvsingh2611-code/office</uri></author>
  {%- for p in collections.posts | limit(60) %}
  {%- set abs = p.url | u %}
  <entry>
    <title>{{ p.data.title }}</title>
    <link href="{{ abs }}" />
    <id>{{ abs }}</id>
    <published>{{ p.date | isoDate }}</published>
    <updated>{{ (p.data.updated or p.date) | isoDate }}</updated>
    {%- if p.data.categoryLabel %}<category term="{{ p.data.categoryLabel }}" />{% endif %}
    <summary>{{ p.data.description }}</summary>
  </entry>
  {%- endfor %}
</feed>
